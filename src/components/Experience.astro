---
const roles = [
  {
    company: "National Taiwan University",
    org: "Department of Smart Medicine & Health Informatics",
    logo: "/logos/ntu.svg",
    period: "2026 — present",
    role: "M.S. Candidate — Smart Medicine & Health Informatics",
    points: [
      "Researching edge AI for crisis-aware medical intelligence: offline triage, population monitoring, and device-to-device applications.",
    ],
  },
  {
    company: "GetGo Carsharing",
    org: "Singapore",
    logo: "/logos/getgo.png",
    period: "Dec 2024 — Jul 2026",
    role: "iOS Developer",
    points: [
      "Developed high-quality enterprise iOS applications and integrated vehicle telematics for reliable connectivity and accurate data.",
      "Adopted Kotlin Multiplatform, cutting code duplication and improving long-term maintainability across iOS & Android.",
    ],
  },
  {
    company: "Traveloka",
    org: "Southeast Asia",
    logo: "/logos/traveloka.png",
    period: "Jan 2021 — Dec 2024",
    role: "Software Engineer — Core Mobile",
    points: [
      "Improved app launch time by 50% using Xcode Profiler.",
      "Led SwiftUI integration across product teams, reaching 50% adoption in UI modules and 100% engineer participation.",
      "Improved app health visibility with AWS Lambda and Datadog integration.",
    ],
  },
  {
    company: "RUPI Digital",
    org: "Indonesia",
    logo: "/logos/rupi.png",
    period: "2020 — 2021",
    role: "iOS Developer",
    points: [
      "Built a production iOS app from scratch with MVVM+C, reusable UI components, and REST API integration.",
      "Resolved bugs and issues across two iOS applications.",
    ],
  },
];
---

<section id="experience" class="experience">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Experience</p>
      <h2 class="section-title">Where I've built.</h2>
    </div>
    <div class="timeline">
      {
        roles.map((r) => (
          <article class="card">
            <div class="logo">
              <img src={r.logo} alt={`${r.company} logo`} loading="lazy" />
            </div>
            <div class="body">
              <div class="row">
                <div>
                  <p class="period">{r.period}</p>
                  <h3 class="role">{r.role}</h3>
                  <p class="org">
                    {r.company}
                    <span class="muted"> · {r.org}</span>
                  </p>
                </div>
              </div>
              <ul class="points">
                {r.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
    <div class="edu">
      <h3 class="edu-title">Education</h3>
      <article class="card">
        <div class="logo">
          <img src="/logos/ciputra.png" alt="Universitas Ciputra logo" loading="lazy" />
        </div>
        <div class="body">
          <div class="row">
            <div>
              <p class="period">2016 — 2020</p>
              <h3 class="role">Bachelor of Computer Science</h3>
              <p class="org">Universitas Ciputra · <span class="muted">GPA 3.91</span></p>
            </div>
          </div>
          <ul class="points">
            <li>Apple Developer Academy graduate (2019).</li>
            <li>Undergrad thesis: deep-learning font classifier with CNN + autoencoder.</li>
          </ul>
        </div>
      </article>
    </div>
    <p class="note">
      Descriptions kept at capability level to respect employer agreements.
    </p>
  </div>
</section>

<style>
  .timeline,
  .edu {
    display: grid;
    gap: 1.25rem;
  }

  .edu {
    margin-top: 2.5rem;
  }

  .edu-title {
    margin: 0 0 -0.2rem;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .card {
    display: flex;
    gap: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.6rem 1.7rem;
  }

  .logo {
    flex: 0 0 56px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #0c1210;
    overflow: hidden;
    padding: 6px;
  }

  .logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .period {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .role {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .org {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .muted {
    color: var(--muted);
  }

  .points {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .points li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
  }

  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(90deg, var(--accent), var(--peach));
  }

  .note {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .card {
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>