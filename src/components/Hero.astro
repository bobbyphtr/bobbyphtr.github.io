---
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content">
      <p class="kicker">Hello, I'm Bobby Pehtrus · 白鎮銓</p>
      <h1>
        Software Engineer, leveling into{" "}
        <span class="accent">smart medicine</span> &amp; health informatics.
      </h1>
      <p class="lede">
        I build dependable mobile and cloud software — the kind people rely
        on every day in Southeast Asia — and I'm now applying that craft to
        patient-facing AI in clinical and crisis contexts.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#experience">View experience</a>
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: -40%;
    bottom: -40%;
    left: 0;
    right: 0;
    background-image: url("/images/profile.jpg");
    background-size: cover;
    background-position: center 30%;
    will-change: transform;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 15, 13, 0.55), rgba(10, 15, 13, 0.82)),
      linear-gradient(90deg, rgba(10, 15, 13, 0.75), rgba(10, 15, 13, 0.25));
    z-index: 1;
  }

  .container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 40rem;
    padding: 8rem 0 7rem;
  }

  .hero h1 {
    margin: 0 0 1.25rem;
    font-size: 3rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .accent {
    background: linear-gradient(90deg, var(--accent), var(--peach));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lede {
    margin: 0 0 2.25rem;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #10141a;
  }

  .btn-primary:hover {
    background: #cfc3f7;
    text-decoration: none;
  }

  .btn-ghost {
    border: 1px solid rgba(240, 242, 239, 0.35);
    background: rgba(10, 15, 13, 0.4);
    color: var(--text);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 92vh;
    }

    .hero-content {
      padding: 6rem 0 5rem;
    }

    .hero h1 {
      font-size: 2.2rem;
    }
  }
</style>

<script>
  const bg = document.querySelector(".hero-bg");
  if (bg && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    let raf = null;
    const update = () => {
      const y = window.scrollY;
      if (y < window.innerHeight * 1.2) {
        bg.style.transform = `translateY(${y * 0.3}px)`;
      }
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!raf) raf = requestAnimationFrame(() => { update(); raf = null; });
      },
      { passive: true }
    );
    update();
  }
</script>