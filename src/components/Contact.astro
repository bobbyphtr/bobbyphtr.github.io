---
const links = [
  { label: "GitHub", href: "https://github.com/bobbyphtr" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/bobbyphtr/" },
  { label: "Instagram", href: "https://www.instagram.com/bobbyphtr/" },
  { label: "Medium", href: "https://bobbyphtr.medium.com/" },
];
---

<section id="contact" class="contact">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Contact</p>
      <h2 class="section-title">Let's build something.</h2>
    </div>
    <p class="lede">
      Working on health-tech or AI in the clinic, want to collaborate, or just
      want to say hi? My inbox is open.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="mailto:bobbypehtrus2@gmail.com">
        Email me
      </a>
      {
        links.map((l) => (
          <a class="btn btn-ghost" href={l.href} target="_blank" rel="noreferrer">{l.label}</a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lede {
    margin: 0 0 2rem;
    max-width: 34rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #10141a;
  }

  .btn-primary:hover {
    background: #cfc3f7;
    text-decoration: none;
  }

  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
</style>