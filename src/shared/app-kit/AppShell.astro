---
// Shared shell for the self-contained mini-apps (North Star, Glossary).
// Inlines kit + app CSS/JS and the default state so the built page is a single
// file that works offline and via file://.
import kitCss from "./ui.css?raw";
import kitJs from "./kit.js?raw";

interface NavItem { id: string; label: string }
interface Props {
  title: string;
  appName: string;
  appSub: string;
  mark: string;
  nav: NavItem[];
  crossLink: { href: string; label: string };
  css: string;
  js: string;
  defaultState: unknown;
  extraTools?: { action: string; label: string }[];
}

const { title, appName, appSub, mark, nav, crossLink, css, js, defaultState, extraTools = [] } = Astro.props;

const stateJson = JSON.stringify(defaultState).replace(/</g, "\\u003c");
const script = `(() => {\n${kitJs}\n${js}\n})();`;
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#0f172a"/><text x="16" y="22" font-size="16" text-anchor="middle" fill="#F59E0B" font-family="sans-serif">${mark}</text></svg>`,
  );
const themeBoot = `try{var t=localStorage.getItem('bobby_career_compass_theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" href={favicon} />
    <script is:inline set:html={themeBoot}></script>
    <style is:inline set:html={kitCss + "\n" + css}></style>
  </head>
  <body>
    <div class="app">
      <aside class="sidebar" id="sidebar" aria-label="Navigation">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">{mark}</span>
          <div>
            <div class="brand-name">{appName}</div>
            <div class="brand-sub">{appSub}</div>
          </div>
        </div>
        <nav class="nav" id="nav">
          {nav.map((item, i) => (
            <a href={`#${item.id}`} data-view={item.id}>
              <span class="nav-no">{String(i + 1).padStart(2, "0")}</span>
              {item.label}
            </a>
          ))}
          <a class="nav-cross" href={crossLink.href}><span class="nav-no">↗</span>{crossLink.label}</a>
        </nav>
        <div class="sidebar-tools">
          <div class="tools-label">Data</div>
          <button class="tool" data-kit="sync-open" type="button">Sync settings…</button>
          <button class="tool" data-kit="sync-now" type="button">Sync now</button>
          <button class="tool" data-kit="export-json" type="button">Export JSON backup</button>
          <button class="tool" data-kit="import-json" type="button">Import JSON backup</button>
          {extraTools.map((t) => <button class="tool" data-action={t.action} type="button">{t.label}</button>)}
        </div>
      </aside>
      <div class="scrim" data-kit="close-nav"></div>
      <div class="main">
        <header class="topbar">
          <button class="icon-btn menu-btn" data-kit="open-nav" type="button" aria-label="Open navigation" aria-controls="sidebar">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </button>
          <h1 class="view-title" id="view-title">{appName}</h1>
          <button class="saved" id="saved" data-kit="sync-open" type="button"><span class="dot"></span><span id="saved-text">Saved locally</span></button>
          <button class="icon-btn" data-kit="toggle-theme" type="button" aria-label="Toggle light/dark mode" title="Toggle light/dark mode">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
          </button>
        </header>
        <main class="view" id="view" tabindex="-1"></main>
      </div>
    </div>

    <input type="file" id="import-file" accept="application/json,.json" hidden />

    <dialog class="modal" id="confirm-modal">
      <form method="dialog">
        <h2 id="confirm-title"></h2>
        <p id="confirm-body"></p>
        <div class="modal-actions">
          <button class="btn btn-ghost" value="cancel" id="confirm-cancel">Cancel</button>
          <button class="btn btn-danger" value="ok" id="confirm-ok">Confirm</button>
        </div>
      </form>
    </dialog>

    <dialog class="modal" id="sync-modal">
      <form id="sync-form" method="dialog" autocomplete="off">
        <h2>Sync with GitHub</h2>
        <p>Keeps North Star and the Glossary in step across your devices by saving them as JSON files in a <strong>private</strong> repo. Use a fine-grained token limited to that one repo with <em>Contents: Read and write</em>. It's stored only in this browser.</p>
        <div class="stack" style="margin-top:14px">
          <label class="field"><span>Repository</span><input class="input" name="repo" placeholder="owner/northstar-data" spellcheck="false" /></label>
          <label class="field"><span>Branch</span><input class="input" name="branch" placeholder="main" spellcheck="false" /></label>
          <label class="field"><span>Fine-grained token</span><input class="input" name="token" type="password" autocomplete="off" spellcheck="false" /></label>
        </div>
        <p class="sync-result" id="sync-result" aria-live="polite"></p>
        <div class="modal-actions">
          <button class="btn btn-ghost" type="button" data-kit="sync-disconnect">Turn off</button>
          <button class="btn btn-ghost" type="button" data-kit="sync-test">Test</button>
          <button class="btn btn-ghost" value="close">Close</button>
          <button class="btn btn-primary" type="button" data-kit="sync-save">Save &amp; sync</button>
        </div>
      </form>
    </dialog>

    <slot name="dialogs" />

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script type="application/json" id="default-state" is:inline set:html={stateJson}></script>
    <script is:inline set:html={script}></script>
  </body>
</html>
